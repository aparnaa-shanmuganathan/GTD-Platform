# Build output. Anchored to the repo root (not a bare "target/") - Phase 8's Target
# Workspace package (src/.../workspace/target/) is also literally named "target", and an
# unanchored pattern would silently exclude its source files from every future commit too.
/target/
*.class

# Logs
logs/
*.log

# Environment / secrets
.env
.env.*

# IDE
.idea/
*.iml
*.iws
.vscode/
.settings/
.classpath
.project
.factorypath
bin/
out/

# Claude Code local settings - machine-specific (absolute paths, locally-approved
# commands, and in this project's case a throwaway local dev DB password). Never
# committed or carried across machines; Claude Code regenerates this per-machine.
.claude/settings.local.json

# OS cruft
.DS_Store
Thumbs.db

# Real GTD dataset (large, licensed - never committed).
# See RealFileImportPerformanceTest / README for how to provide it locally.
/data/

# Phase 11 packaging build output (jlink runtime images, staged jars, built installers) -
# large, machine/OS-specific, entirely reproducible from packaging/*/build.sh|.ps1. The
# scripts themselves and packaging/common/ ARE committed; only their output is not.
/packaging/build/

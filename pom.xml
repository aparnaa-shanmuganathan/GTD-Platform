<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.gtd.platform</groupId>
    <artifactId>gtd-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>gtd-platform</name>
    <description>GTD Analytical Platform - offline Business Intelligence and Decision Support Platform</description>

    <properties>
        <java.version>21</java.version>
        <!--
            Every other dependency below is version-managed by spring-boot-starter-parent's
            dependencyManagement (spring-boot-dependencies BOM), which pins exact versions
            (never ranges) for spring-boot-starter-*, spring-session-jdbc (via spring-session-bom),
            flyway-core/flyway-database-postgresql, the PostgreSQL JDBC driver, JUnit 5, Mockito,
            AssertJ, and Testcontainers (via testcontainers-bom). io.zonky.test:embedded-postgres
            is NOT covered by that BOM, so it is pinned explicitly below.
        -->
        <embedded-postgres.version>2.0.7</embedded-postgres.version>
        <!-- Phase 11 (packaging): embedded-postgres 2.0.7's own pom hardcodes Postgres 14.10.1
             binaries by default, which drifted from CLAUDE.md section 2's frozen "PostgreSQL 16+"
             target unnoticed since nothing had ever exercised the discrepancy. Pinned explicitly
             here (overriding the transitive default via direct, nearer dependency declarations
             below) so both the test fallback path and the new production embedded-Postgres
             bootstrap (shared.bootstrap) run the same major version as the frozen stack and as
             the Testcontainers postgres:16-alpine path. -->
        <embedded-postgres-binaries.version>16.14.0</embedded-postgres-binaries.version>
        <!-- CSV parsing (Phase 3, IMPORT service) - not covered by Spring Boot's BOM.
             Added with the user's explicit sign-off; a hand-rolled parser risks silent
             column misalignment on the real data's quoted/escaped summary/citation fields. -->
        <commons-csv.version>1.10.0</commons-csv.version>
        <!-- REPORT service PDF generation (Phase 6) - not covered by Spring Boot's BOM.
             See CLAUDE.md section 2 for the Flying Saucer vs OpenPDF decision. -->
        <flying-saucer.version>9.4.0</flying-saucer.version>
        <!-- Test-only: extracts text from generated PDFs so REPORT service tests can assert
             on actual rendered content, not just "bytes came back". Never used at runtime. -->
        <pdfbox.version>3.0.8</pdfbox.version>
    </properties>

    <dependencies>
        <!-- Core web / view layer -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Schema migrations -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Ops / health -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Session management (JDBC-backed, no Redis - offline/air-gapped requirement) -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-jdbc</artifactId>
        </dependency>

        <!-- CSV parsing for the IMPORT service (Phase 3) and the REPORT service's CSV export (Phase 6) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>${commons-csv.version}</version>
        </dependency>

        <!-- PDF generation for the REPORT service (Phase 6): Flying Saucer renders XHTML/CSS
             to PDF (so report content is authored as a Thymeleaf template, not built up
             programmatically). As of 9.4.0 the "-openpdf" artifact was merged back into this
             canonical one (Maven prints a relocation notice for the old artifact id) - "flying-saucer-pdf"
             itself now depends on com.github.librepdf:openpdf (1.3.35), not the classic
             bundled iText 2.1.7, so this single dependency combines both options named in
             CLAUDE.md section 2's original either/or. See CLAUDE.md section 2 for the full
             rationale. -->
        <dependency>
            <groupId>org.xhtmlrenderer</groupId>
            <artifactId>flying-saucer-pdf</artifactId>
            <version>${flying-saucer.version}</version>
        </dependency>

        <!-- Auth: session-based login/logout, BCrypt password hashing, CSRF protection.
             Not in CLAUDE.md's originally frozen stack list - added in Phase 2 with the
             user's explicit sign-off rather than silently. See CLAUDE.md section 12. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Phase 0/Phase 7 (test fallback) AND Phase 11 (production embedded-Postgres
             bootstrap, shared.bootstrap.EmbeddedPostgresEnvironmentPostProcessor): this is
             no longer test-only, so it carries no <scope> (defaults to compile, available at
             main compile/runtime as well as test). It is still a thin process-management
             wrapper around real Postgres binaries, not a heavyweight library - see
             CLAUDE.md's Phase 11 packaging notes. The four platform-binaries artifacts
             embedded-postgres's own pom pulls in transitively at 14.10.1 are excluded so the
             16.14.0 versions declared explicitly below (nearer, so they'd win either way, but
             excluded too to avoid shipping unused duplicate 14.10.1 jars) are what actually
             resolve. -->
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>${embedded-postgres.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-windows-amd64</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-darwin-amd64</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-linux-amd64</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-linux-amd64-alpine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- This dev/CI machine's own platform (Apple Silicon macOS) - needed unconditionally
             so `mvn test`'s embedded-postgres fallback path (PostgresIntegrationTestBase) and
             a macOS-arm64 packaged build both resolve a real Postgres 16 binary without
             requiring a packaging profile to be active. The other four platform/arch binaries
             below are added only by their respective packaging profile, each producing exactly
             one OS's installer, so a normal dev build/test run doesn't carry all five ~30-50MB
             binary archives on its classpath. -->
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-darwin-arm64v8</artifactId>
            <version>${embedded-postgres-binaries.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- Test-only: extracts text from REPORT service-generated PDFs so tests can assert
             on actual content (CLAUDE.md section 14's "not just a number comes back" standard),
             not shipped in the packaged application. -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>gtd-platform</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!-- Phase 11 (packaging/installer): one profile per target OS/arch this platform ships an
         installer for (CLAUDE.md section 3). Each activates ONLY the one matching
         embedded-postgres-binaries artifact needed to bundle a real Postgres 16 server into
         that OS's app image (packaging/*/build.sh|.ps1 activates the matching profile before
         calling jpackage) - never all five at once, which would otherwise bloat every
         installer with four other platforms' unused binary archives. The darwin-arm64v8
         profile is a no-op alias of the unconditional dependency above (kept for symmetry/
         documentation - the packaging README still tells a macOS-arm64 build to activate it
         explicitly rather than relying on the reader knowing it's already unconditional). -->
    <profiles>
        <profile>
            <id>package-macos-arm64</id>
            <dependencies>
                <dependency>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-darwin-arm64v8</artifactId>
                    <version>${embedded-postgres-binaries.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>package-macos-amd64</id>
            <dependencies>
                <dependency>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-darwin-amd64</artifactId>
                    <version>${embedded-postgres-binaries.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>package-windows-amd64</id>
            <dependencies>
                <dependency>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-windows-amd64</artifactId>
                    <version>${embedded-postgres-binaries.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>package-linux-amd64</id>
            <dependencies>
                <dependency>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-linux-amd64</artifactId>
                    <version>${embedded-postgres-binaries.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>package-linux-arm64</id>
            <dependencies>
                <dependency>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-linux-arm64v8</artifactId>
                    <version>${embedded-postgres-binaries.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

</project>
